<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-Content-Type-Options" content="nosniff">
  <meta http-equiv="Referrer-Policy" content="strict-origin-when-cross-origin">
  <meta http-equiv="Permissions-Policy" content="geolocation=(self)">
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; upgrade-insecure-requests; img-src 'self' https: data: blob:; script-src 'self' 'unsafe-inline' https://unpkg.com; style-src 'self' 'unsafe-inline' https://unpkg.com; font-src 'self' https: data:; connect-src 'self' https:; frame-src https://www.youtube.com https://www.youtube-nocookie.com;">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover"/>
  <title>Bo’CitéArt</title>
  <meta name="theme-color" content="#a51e22">
  <link rel="icon" type="image/png" sizes="32x32" href="favicon-32.png">
  <link rel="apple-touch-icon" sizes="180x180" href="icon-180.png">

  <style>
    :root{
      --bg:#f1e6d6;
      --surface:#ffffff;
      --beige:#efe4d3;
      --green:#2f5d46;
      --red:#a51e22;
      --redSoft:#7f1a1d;
      --text:#1f1f1f;
      --muted:#6e6a63;
      --link:#1d4ed8;
      --vh:1vh;
    }
    *{ box-sizing:border-box; }
    html, body{ height:100%; margin:0; padding:0; }
    body{
      font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;
      background:var(--bg);
      color:var(--text);
      -webkit-text-size-adjust:100%;
      text-size-adjust:100%;
      overscroll-behavior:none;
    }
    body.modalOpen{ overflow:hidden; }
    .page{
      min-height:100vh;
      min-height:100dvh;
      display:flex;
      justify-content:center;
      align-items:flex-start;
    }
    .wrap{
      width:100%;
      max-width:420px;
      margin:0 auto;
      padding:10px;
      display:flex;
      flex-direction:column;
      gap:10px;
    }

    .ticker{
      position:relative;
      overflow:hidden;
      border-radius:18px;
      background:var(--beige);
      height:130px;
      min-height:130px;
      cursor:pointer;
    }
    .ticker img{
      position:absolute;
      inset:0;
      width:100%;
      height:100%;
      object-fit:cover;
    }
    .ticker .overlay{
      position:absolute;
      inset:0;
      background:linear-gradient(90deg, rgba(0,0,0,.55), rgba(0,0,0,.12));
    }
    .ticker .row{
      position:absolute;
      inset:0;
      display:flex;
      align-items:center;
      padding:0 14px;
      gap:12px;
      overflow:hidden;
      min-height:100%;
    }
    .marquee{
      display:flex;
      gap:0;
      white-space:nowrap;
      animation:marquee 32s linear infinite;
      will-change:transform;
      width:max-content;
    }
    .marquee .item{
      display:flex;
      flex-direction:column;
      min-width:520px;
      padding-right:80px;
    }
    .ticker .title{ color:#fff; font-weight:800; font-size:14px; }
    .ticker .sub{ color:rgba(255,255,255,.92); font-weight:700; font-size:12px; margin-top:2px; }
    .ticker .rule{
      margin-left:auto;
      color:rgba(255,255,255,.92);
      font-size:11px;
      font-weight:700;
      flex:0 0 auto;
    }
    @keyframes marquee{
      0%{ transform:translateX(0); }
      100%{ transform:translateX(-50%); }
    }

    .gridWrap{ position:relative; }
    .grid{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:12px;
    }
    .tile{
      position:relative;
      width:100%;
      aspect-ratio:1 / 0.58;
      border-radius:22px;
      overflow:hidden;
      background:var(--beige);
      cursor:pointer;
    }
    .tile img{
      position:absolute;
      inset:0;
      width:100%;
      height:100%;
      object-fit:cover;
    }
    .tile .overlay{
      position:absolute;
      inset:0;
      background:linear-gradient(180deg, rgba(0,0,0,.22), rgba(0,0,0,.55));
    }
    .tile .content{
      position:absolute;
      inset:0;
      display:flex;
      flex-direction:column;
      justify-content:center;
      align-items:center;
      text-align:center;
      padding:12px;
      color:#fff;
    }
    .tile .h{ font-weight:900; font-size:18px; line-height:1.15; }
    .tile .p{ margin-top:8px; font-weight:700; font-size:12px; color:rgba(255,255,255,.92); }

    .tile.logoOnly{
      background:#fff;
      display:flex;
      align-items:center;
      justify-content:center;
    }
    .tile.logoOnly img{
      object-fit:cover;
      padding:0;
      background:#fff;
    }
    .tile.logoOnly .overlay{ display:none; }

    .tileBadge{
      position:absolute;
      top:10px;
      right:10px;
      width:14px;
      height:14px;
      border-radius:999px;
      background:#1f8f4d;
      border:2px solid #fff;
      box-shadow:0 0 0 2px rgba(0,0,0,.08);
      z-index:3;
      animation:badgePulse 1.2s infinite;
    }
    @keyframes badgePulse{
      0%{ transform:scale(1); opacity:1; }
      50%{ transform:scale(1.18); opacity:.75; }
      100%{ transform:scale(1); opacity:1; }
    }

    .emgSlot{
      position:absolute;
      left:50%;
      transform:translate(-50%,-50%);
      padding:6px;
      border-radius:999px;
      background:var(--bg);
      z-index:20;
    }
    .emgTop{ top:33.333%; }
    .emgBottom{ top:66.666%; }

    .lpBtn{
      position:relative;
      width:90px;
      height:90px;
      border:none;
      background:transparent;
      padding:0;
      touch-action:none;
      cursor:pointer;
    }
    .lpRing{ position:absolute; inset:0; }
    .lpCore{
      position:absolute;
      left:50%;
      top:50%;
      transform:translate(-50%,-50%);
      width:74px;
      height:74px;
      border-radius:999px;
      display:flex;
      flex-direction:column;
      align-items:center;
      justify-content:center;
      color:#fff;
      font-weight:700;
      box-shadow:0 10px 20px rgba(0,0,0,.18);
      user-select:none;
    }
    .lpSmall{ width:68px; height:68px; }
    .lpCore .icon{ width:16px; height:16px; margin-bottom:2px; opacity:.95; }
    .lpCore .lbl{ font-size:12px !important; line-height:1; font-weight:700 !important; }
    .lpCore .lblSmall{ font-size:8px !important; line-height:1; font-weight:700 !important; }

    #btn112 .lblSmallTop{ font-size:7px !important; line-height:1 !important; }
    #btn112 .icon{ width:14px !important; height:14px !important; margin-bottom:1px !important; }
    #btnSos .lblTop{ font-size:7px !important; line-height:1.05 !important; font-weight:800 !important; }
    #btnSos .icon{ width:12px !important; height:12px !important; margin:2px 0 !important; }
    #btnSos #sosLabel{ font-size:7px !important; line-height:1 !important; font-weight:900 !important; }
    .red{ background:linear-gradient(180deg,var(--red),var(--redSoft)); }
    .green{ background:linear-gradient(180deg,#3c7b5d,#2f5d46); }
    .bottomBar{
      display:grid;
      grid-template-columns:1fr auto 1fr;
      align-items:center;
      gap:10px;
      margin-top:2px;
    }

    .miniBtn{
      border:none;
      border-radius:18px;
      background:var(--beige);
      padding:10px;
      min-height:72px;
      position:relative;
      overflow:hidden;
      cursor:pointer;
    }

    .miniClock{
      display:flex;
      flex-direction:column;
      align-items:flex-start;
      justify-content:center;
      min-height:72px;
    }

    .miniClock .time{
      font-size:22px;
      font-weight:900;
      line-height:1;
    }

    .miniClock .date{
      margin-top:4px;
      font-size:12px;
      font-weight:800;
    }

    .miniClock .saint{
      margin-top:2px;
      font-size:10px;
      color:#555;
      font-weight:700;
    }

    .miniDae{
      display:flex;
      flex-direction:column;
      align-items:center;
      justify-content:center;
      min-height:72px;
      text-align:center;
    }

    .miniDae .daeIcon{
      font-size:22px;
      line-height:1;
    }

    .miniDae .daeText{
      margin-top:4px;
      font-size:11px;
      font-weight:900;
    }

    .modal{
      position:fixed;
      inset:0;
      display:none;
      align-items:flex-end;
      justify-content:center;
      background:rgba(0,0,0,.45);
      z-index:9999;
      padding:0;
    }

    .modal.open{ display:flex; }

    .sheet{
      width:100%;
      max-width:420px;
      max-height:92vh;
      background:#fff;
      border-radius:22px 22px 0 0;
      overflow:auto;
      padding:18px;
      animation:sheetUp .22s ease-out;
    }

    @keyframes sheetUp{
      from{
        transform:translateY(30px);
        opacity:0;
      }
      to{
        transform:translateY(0);
        opacity:1;
      }
    }

    .sheetHead{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:10px;
      margin-bottom:14px;
    }

    .sheetTitle{
      font-size:18px;
      font-weight:900;
    }

    .closeBtn{
      border:none;
      background:#eee;
      width:34px;
      height:34px;
      border-radius:999px;
      font-size:18px;
      font-weight:900;
      cursor:pointer;
    }

    .box{
      border-radius:16px;
      background:#f8f6f2;
      padding:12px;
      margin-top:10px;
    }

    .choiceBtn{
      border:none;
      border-radius:14px;
      background:var(--green);
      color:#fff;
      padding:12px 14px;
      font-weight:900;
      cursor:pointer;
    }

    .muted{
      color:#666;
      font-size:12px;
    }

    iframe{
      border:none;
      width:100%;
    }

    @media (max-width:390px){
      .lpBtn{
        width:82px;
        height:82px;
      }

      .lpCore{
        width:66px;
        height:66px;
      }

      .lpSmall{
        width:62px;
        height:62px;
      }
    }
  </style>
</head>

<body>

<div class="page">
  <div class="wrap">

    <!-- GRAND BANDEAU -->
    <div class="ticker" id="ticker">

      <img src="https://images.unsplash.com/photo-1528698827591-e19ccd7bc23d?auto=format&fit=crop&w=1200&q=60" alt="Bo'CitéArt">

      <div class="overlay"></div>

      <div class="row">

        <div class="marquee">

          <div class="item">
            <div class="title">Bo’CitéArt — ville citoyenne connectée</div>
            <div class="sub">fresques • commerces • sport • musique • écoles • mairie</div>
          </div>

          <div class="item">
            <div class="title">Publicité locale</div>
            <div class="sub">bandeau dynamique multi-acteurs</div>
          </div>

          <div class="item">
            <div class="title">Bo’CitéArt — participation citoyenne</div>
            <div class="sub">application territoriale vivante</div>
          </div>

          <div class="item">
            <div class="title">Bo’CitéArt — ville citoyenne connectée</div>
            <div class="sub">fresques • commerces • sport • musique • écoles • mairie</div>
          </div>

        </div>

      </div>

    </div>

    <!-- TUILES -->
    <div class="gridWrap">

      <!-- 112 -->
      <div class="emgSlot emgTop">

        <button class="lpBtn" id="btn112">

          <svg class="lpRing" viewBox="0 0 90 90">
            <circle cx="45" cy="45" r="35"
              fill="none"
              stroke="rgba(255,255,255,.22)"
              stroke-width="6"/>
            <circle id="ring112"
              cx="45"
              cy="45"
              r="35"
              fill="none"
              stroke="#ffffff"
              stroke-width="6"
              stroke-linecap="round"
              transform="rotate(-90 45 45)"
              stroke-dasharray="220"
              stroke-dashoffset="220"/>
          </svg>

          <div class="lpCore red">

            <div class="lblSmall lblSmallTop">urgence</div>

            <svg class="icon" viewBox="0 0 24 24" fill="none">
              <path d="M12 3l7 4v5c0 5-3.5 8-7 9-3.5-1-7-4-7-9V7l7-4z"
                stroke="white"
                stroke-width="2"/>
            </svg>

            <div class="lbl">112</div>

          </div>

        </button>

      </div>

      <!-- 3919 / 119 -->
      <div class="emgSlot emgBottom">

        <button class="lpBtn" id="btnSos">

          <svg class="lpRing" viewBox="0 0 90 90">
            <circle cx="45" cy="45" r="35"
              fill="none"
              stroke="rgba(255,255,255,.22)"
              stroke-width="6"/>
            <circle id="ringSos"
              cx="45"
              cy="45"
              r="35"
              fill="none"
              stroke="#ffffff"
              stroke-width="6"
              stroke-linecap="round"
              transform="rotate(-90 45 45)"
              stroke-dasharray="220"
              stroke-dashoffset="220"/>
          </svg>

          <div class="lpCore green lpSmall">

            <div class="lblSmall lblTop">aide</div>

            <svg class="icon" viewBox="0 0 24 24" fill="none">
              <path d="M12 21s-7-4.5-7-11a4 4 0 0 1 7-2 4 4 0 0 1 7 2c0 6.5-7 11-7 11z"
                stroke="white"
                stroke-width="2"/>
            </svg>

            <div id="sosLabel" class="lblSmall">3919 / 119</div>

          </div>

        </button>

      </div>

      <div class="grid">

        <!-- Bo'CitéArt -->
        <div class="tile logoOnly">

          <img src="https://upload.wikimedia.org/wikipedia/commons/3/3f/Placeholder_view_vector.svg"
               alt="Bo'CitéArt">

        </div>

        <!-- Œuvres -->
        <div class="tile">
          <img src="https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?auto=format&fit=crop&w=1200&q=60">
          <div class="overlay"></div>
          <div class="content">
            <div class="h">Œuvres</div>
            <div class="p">fresques & patrimoine</div>
          </div>
        </div>

        <!-- Commerces -->
        <div class="tile">
          <img src="https://images.unsplash.com/photo-1481437156560-3205f6a55735?auto=format&fit=crop&w=1200&q=60">
          <div class="overlay"></div>
          <div class="content">
            <div class="h">Commerces</div>
            <div class="p">bons plans & WattCoins</div>
          </div>
        </div>

        <!-- École -->
        <div class="tile">
          <img src="https://images.unsplash.com/photo-1509062522246-3755977927d7?auto=format&fit=crop&w=1200&q=60">
          <div class="overlay"></div>
          <div class="content">
            <div class="h">École</div>
            <div class="p">mot du jour & citoyenneté</div>
          </div>
        </div>

        <!-- Musique -->
        <div class="tile">
          <img src="https://images.unsplash.com/photo-1493225457124-a3eb161ffa5f?auto=format&fit=crop&w=1200&q=60">
          <div class="overlay"></div>
          <div class="content">
            <div class="h">Voix de la Ville</div>
            <div class="p">musique & talents locaux</div>
          </div>
        </div>

        <!-- Sport -->
        <div class="tile">
          <img src="https://images.unsplash.com/photo-1517649763962-0c623066013b?auto=format&fit=crop&w=1200&q=60">
          <div class="overlay"></div>
          <div class="content">
            <div class="h">Sport</div>
            <div class="p">clubs & engagement civique</div>
          </div>
        </div>

        <!-- Mairie -->
        <div class="tile">
          <img src="https://images.unsplash.com/photo-1511818966892-d7d671e672a2?auto=format&fit=crop&w=1200&q=60">
          <div class="overlay"></div>
          <div class="content">
            <div class="h">Mairie</div>
            <div class="p">infos & alertes</div>
          </div>
        </div>

      </div>

    </div>

    <!-- BAS -->
    <div class="bottomBar">

      <!-- HORLOGE -->
      <button class="miniBtn" id="clockBtn">

        <div class="miniClock">

          <div id="clockTimeMini" class="time">00:00</div>

          <div id="clockDateMini" class="date">00/00/0000</div>

          <div id="clockSaintMini" class="saint">Saint du jour</div>

        </div>

      </button>

      <!-- DAE -->
      <button class="miniBtn" id="daeBtn">

        <div class="miniDae">

          <div class="daeIcon">❤️</div>

          <div class="daeText">
            DAE<br>
            Défibrillateur
          </div>

        </div>

      </button>

    </div>

  </div>
</div>

<!-- MODAL -->
<div class="modal" id="modal">

  <div class="sheet">

    <div class="sheetHead">

      <div id="modalTitle" class="sheetTitle"></div>

      <button id="modalClose" class="closeBtn">×</button>

    </div>

    <div id="modalBody"></div>

  </div>

</div>

<!-- CHOIX SOS -->
<div class="modal" id="choice">

  <div class="sheet">

    <div class="sheetHead">

      <div class="sheetTitle">Choisir un numéro</div>

      <button id="choiceX" class="closeBtn">×</button>

    </div>

    <div class="box">
      Sélectionnez le numéro d’aide souhaité.
    </div>

    <div style="display:grid;gap:10px;margin-top:14px;">

      <button class="choiceBtn" data-pick="3919">
        3919 — violences
      </button>

      <button class="choiceBtn" data-pick="119">
        119 — enfance en danger
      </button>

      <button class="choiceBtn" id="choiceClose" style="background:#999;">
        fermer
      </button>

    </div>

  </div>

</div>

<script>

(function(){

  const $ = (id)=>document.getElementById(id);

  const modal = $("modal");
  const modalTitle = $("modalTitle");
  const modalBody = $("modalBody");

  function openModal(title, html){
    modalTitle.innerHTML = title || "";
    modalBody.innerHTML = html || "";
    modal.classList.add("open");
    document.body.style.overflow = "hidden";
  }

  function closeModal(){
    modal.classList.remove("open");
    document.body.style.overflow = "";
  }

  $("modalClose").onclick = closeModal;

  modal.addEventListener("click",(e)=>{
    if(e.target === modal){
      closeModal();
    }
  });

  window.openModal = openModal;
  window.closeModal = closeModal;

  function getSaintOfDay(){
    return "Saint du jour";
  }

  function refreshMiniClock(){

    const now = new Date();

    $("clockTimeMini").textContent =
      now.toLocaleTimeString("fr-FR",{
        hour:"2-digit",
        minute:"2-digit"
      });

    $("clockDateMini").textContent =
      now.toLocaleDateString("fr-FR");

    $("clockSaintMini").textContent =
      getSaintOfDay();

  }

  refreshMiniClock();

  setInterval(refreshMiniClock,30000);

  // DAE
  $("daeBtn").onclick = ()=>{

    openModal("Défibrillateur (DAE)",`

      <div class="box">

        <strong>Défibrillateur le plus proche</strong><br><br>

        En cas d’urgence vitale, appelez immédiatement le <strong>112</strong>.

      </div>

      <div class="box">

        <strong>Fonctions prévues :</strong>

        <ul style="margin:8px 0 0 18px;font-weight:800;">
          <li>localisation GPS ;</li>
          <li>itinéraire réel ;</li>
          <li>guidage vers DAE ;</li>
          <li>compatibilité mobile HTTPS ;</li>
        </ul>

      </div>

      <div class="box">

        <strong>🎥 Vidéo DAE</strong>

        <div style="margin-top:10px;border-radius:14px;overflow:hidden;background:#000;">

          <iframe
            height="220"
            src="https://www.youtube.com/embed/3CAmp8yKYEg?rel=0&modestbranding=1"
            allowfullscreen
            loading="lazy">
          </iframe>

        </div>

        <div class="muted" style="margin-top:8px;">
          Vidéo d’explication des gestes essentiels.
        </div>

      </div>

      <div class="box">

        <button class="choiceBtn"
          onclick="window.open('https://www.google.com/maps','_blank')">

          ouvrir l’itinéraire

        </button>

      </div>

    `);

  };

  // HORLOGE
  $("clockBtn").onclick = ()=>{

    openModal("Calendrier • météo • informations du jour",`

      <div class="box" style="text-align:center;">

        <div style="
          font-size:42px;
          font-weight:900;
          line-height:1;
        ">
          ${new Date().toLocaleTimeString("fr-FR")}
        </div>

        <div style="
          margin-top:8px;
          font-size:18px;
          font-weight:800;
        ">
          ${new Date().toLocaleDateString("fr-FR")}
        </div>

        <div class="muted" style="margin-top:10px;">
          météo locale • calendrier • informations du jour
        </div>

      </div>

    `);

  };

})();
</script>

</body>
</html>
