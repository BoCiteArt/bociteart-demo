
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<title>Test Bandeau Direct</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<style>
  body { font-family: Arial, sans-serif; margin:0; background:#f5f5f5; }
  header { background:#111; color:#fff; padding:20px; text-align:center; }
  #topTicker { background:#fff; color:#111; padding:20px; margin:15px; border-radius:12px; border:2px solid #ddd; min-height:110px; }
  #tickerTitleA { font-weight:900; font-size:19px; }
  #tickerSubA { font-size:15px; margin-top:6px; line-height:1.4; }
  .box { background:#fff; margin:15px; padding:20px; border-radius:12px; border:1px solid #ddd; }
  textarea { width:100%; padding:15px; border:2px solid #a51e22; border-radius:10px; font-size:16px; min-height:140px; }
  button { padding:15px; width:100%; margin:10px 0; background:#a51e22; color:white; border:none; border-radius:10px; font-size:17px; font-weight:bold; }
</style>
</head>
<body>

<header>
  <h2>Bo'CitéArt - Test Direct</h2>
  <div id="topTicker">
    <div id="tickerTitleA">Annonce partenaire</div>
    <div id="tickerSubA">Aucune publicité active</div>
  </div>
</header>

<div class="box">
  <h3>Écris ici → le texte apparaît en haut</h3>
  
  <b>Titre</b>
  <input id="titleInput" value="Mairie" style="width:100%; padding:12px; margin-bottom:10px;">

  <b>Texte publicité</b>
  <textarea id="textInput" placeholder="Tape ton texte ici...">Grand concert de cirque ce soir à 21h - il reste 52 places - faire vite !</textarea>

  <button onclick="resetAll()">Réinitialiser</button>
</div>

<script>
  function updateBandeau() {
    const title = document.getElementById("titleInput").value.trim() || "Mairie";
    const text  = document.getElementById("textInput").value.trim() || "";

    document.getElementById("tickerTitleA").textContent = "Mairie — " + title;
    document.getElementById("tickerSubA").textContent = text;
  }

  document.getElementById("titleInput").addEventListener("input", updateBandeau);
  document.getElementById("textInput").addEventListener("input", updateBandeau);

  function resetAll() {
    if (confirm("Réinitialiser ?")) {
      document.getElementById("titleInput").value = "Mairie";
      document.getElementById("textInput").value = "";
      updateBandeau();
    }
  }

  // Initialisation
  updateBandeau();
</script>

</body>
</html>
