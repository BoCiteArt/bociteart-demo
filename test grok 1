<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<title>Bo’CitéArt - Correction Bandeau Mairie</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<style>
  body { font-family: Arial, sans-serif; margin:0; background:#f5f5f5; }
  header { background:#111; color:#fff; padding:20px; text-align:center; }
  #topTicker { background:#fff; color:#111; padding:20px; margin:15px; border-radius:12px; border:2px solid #ddd; min-height:110px; }
  #tickerTitleA { font-weight:900; font-size:19px; }
  #tickerSubA { font-size:15px; margin-top:6px; line-height:1.4; }
  .box { background:#fff; margin:15px; padding:20px; border-radius:12px; border:1px solid #ddd; }
  input, textarea { width:100%; padding:12px; margin:8px 0; border:1px solid #ccc; border-radius:8px; box-sizing:border-box; }
  button { padding:15px; width:100%; background:#a51e22; color:white; border:none; border-radius:10px; font-size:17px; font-weight:bold; cursor:pointer; }
</style>
</head>
<body>

<header>
  <h2>Bo'CitéArt</h2>
  <div id="topTicker">
    <div id="tickerTitleA">Annonce partenaire</div>
    <div id="tickerSubA">Aucune publicité active</div>
  </div>
</header>

<div class="box">
  <h3>Onglet Mairie - Raccordé au bandeau</h3>

  <b>Date</b>
  <input id="mairieDate" type="date" value="2026-04-25">

  <b>Titre publicité</b>
  <input id="mairieTitle" value="Concert des artistes">

  <b>Texte publicité</b>
  <textarea id="mairieText" rows="4">Grand concert de cirque ce soir à 21h - il reste 52 places - faire vite !</textarea>

  <button id="mairieApplyBtn">VALIDER ET DIFFUSER DANS LE GRAND BANDEAU</button>
</div>

<script>
  // Fonction qui met à jour le grand bandeau
  function diffuserMairiePub() {
    const date  = document.getElementById("mairieDate").value || "";
    const title = document.getElementById("mairieTitle").value.trim() || "Mairie";
    const text  = document.getElementById("mairieText").value.trim() || "Information importante";

    const finalTitle = date ? `Mairie (${date}) — ${title}` : `Mairie — ${title}`;

    // Mise à jour directe du bandeau
    document.getElementById("tickerTitleA").textContent = finalTitle;
    document.getElementById("tickerSubA").textContent = text;

    alert("✅ Publicité Mairie diffusée dans le grand bandeau !");
  }

  // Brancher le bouton
  document.getElementById("mairieApplyBtn").addEventListener("click", diffuserMairiePub);

  console.log("Raccordement Mairie → Grand Bandeau activé");
</script>

</body>
</html>
