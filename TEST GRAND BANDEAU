<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<title>Test Bandeau Ultra Minimal</title>
<style>
  body { font-family: Arial; margin:0; padding:20px; background:#f0f0f0; }
  #bandeau { 
    background: white; 
    border: 3px solid red; 
    padding: 30px; 
    margin: 20px 0; 
    font-size: 20px; 
    text-align: center;
  }
  textarea { width: 100%; height: 120px; padding: 10px; font-size: 16px; }
  button { padding: 15px; font-size: 18px; background: #a51e22; color: white; border: none; width: 100%; margin-top: 10px; }
</style>
</head>
<body>

<h2>Test Ultra Simple - Grand Bandeau</h2>

<div id="bandeau">
  <strong id="titre">Annonce partenaire</strong><br>
  <span id="texte">Aucune publicité active</span>
</div>

<div>
  <textarea id="inputTexte" placeholder="Écris ici ton texte...">Test : ma pub doit apparaître en haut</textarea>
  <button onclick="mettreAJour()">METTRE À JOUR LE BANDEAU EN HAUT</button>
</div>

<script>
  function mettreAJour() {
    const texte = document.getElementById("inputTexte").value;
    document.getElementById("texte").textContent = texte;
    alert("Le bandeau a été mis à jour !");
  }
</script>

</body>
</html>
